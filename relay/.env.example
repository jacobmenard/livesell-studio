# Must be the same value as RELAY_SECRET in backend/.env.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RELAY_SECRET=

# Where Laravel runs (php artisan serve).
LARAVEL_URL=http://localhost:8000

# The Vite dev server proxies /relay to this port (see frontend/vite.config.ts).
RELAY_PORT=8090
RELAY_HOST=127.0.0.1

# Full path to ffmpeg.exe if it isn't on your PATH. After "winget install --id Gyan.FFmpeg" it is
# 'C:/Users/<you>/AppData/Local/Microsoft/WinGet/Links/ffmpeg.exe' (keep the quotes if it has spaces).
FFMPEG_PATH=
