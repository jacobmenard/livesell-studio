# NegosyoWork Studio: backend/.env on the server. Copy this to backend/.env there and fill in
# every CHANGE_ME. Never commit the filled-in file. Generate secrets ON THE SERVER:
#   php artisan key:generate                                  (APP_KEY)
#   php -r "echo bin2hex(random_bytes(10)), PHP_EOL;"         (REVERB_APP_KEY)
#   php -r "echo bin2hex(random_bytes(20)), PHP_EOL;"         (REVERB_APP_SECRET)
#   php -r "echo random_int(100000, 999999), PHP_EOL;"         (REVERB_APP_ID)
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"         (RELAY_SECRET)

APP_NAME="NegosyoWork Studio"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://DOMAIN
APP_TIMEZONE=Asia/Manila
# The app sellers open (its own subdomain): links in emails, and the only site allowed to call the API.
FRONTEND_URL=https://APP_DOMAIN

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_LEVEL=warning

# The database you created in CloudPanel (Databases).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CHANGE_ME
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# Login cookies: shared by APP_DOMAIN and DOMAIN through their parent domain (note the
# leading dot, e.g. .example.com), https only.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.PARENT_DOMAIN
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=APP_DOMAIN

# Reverb (instant popups). Laravel talks to it locally; browsers reach it through Nginx (/app/).
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=CHANGE_ME
REVERB_APP_KEY=CHANGE_ME
REVERB_APP_SECRET=CHANGE_ME
REVERB_HOST=127.0.0.1
REVERB_PORT=6001
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=6001
REVERB_ALLOWED_ORIGINS=APP_DOMAIN

FILESYSTEM_DISK=local
MEDIA_DISK=public
# Uploaded photos and sounds are linked as /storage/... on the app's own address (APP_DOMAIN
# serves them, deploy/nginx-app.conf), so the app can mix sounds into a live without CORS.
PUBLIC_STORAGE_URL=/storage
# Nothing in the app needs a background worker.
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Your email provider's SMTP details (Hostinger email, Gmail app password, Brevo, ...),
# for password resets and payment notifications.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=CHANGE_ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
# Emails come from this address (e.g. no-reply@PARENT_DOMAIN). With Hostinger email it must
# be the mailbox in MAIL_USERNAME or an alias of it, or the mail server refuses to send.
MAIL_FROM_ADDRESS="no-reply@PARENT_DOMAIN"
MAIL_FROM_NAME="${APP_NAME}"

# Your business inbox: an email for every payment to check, and where sellers' replies go.
LIVESELL_PAYMENTS_EMAIL=support@PARENT_DOMAIN

# The superadmin created by `php artisan db:seed --force`. Use your real email and a strong
# password (production refuses to create the account without one).
SUPERADMIN_NAME="Super Admin"
SUPERADMIN_EMAIL=CHANGE_ME
SUPERADMIN_PASSWORD=CHANGE_ME

# Must match relay/.env.
RELAY_SECRET=CHANGE_ME
