# NegosyoWork Studio: frontend/.env on the server (read when running `npm run build`).
# Copy this to frontend/.env there. Rebuild after changing it.

# The API site (Laravel, Reverb and the streaming relay).
VITE_API_URL=https://DOMAIN

# Same value as REVERB_APP_KEY in backend/.env.
VITE_REVERB_APP_KEY=CHANGE_ME
# Instant popups connect to https://DOMAIN/app/..., which Nginx passes to Reverb.
VITE_REVERB_HOST=DOMAIN
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# Optional: self-hosted models (otherwise they load from Google's servers).
VITE_SEGMENTER_MODEL_URL=
VITE_FACE_MODEL_URL=
