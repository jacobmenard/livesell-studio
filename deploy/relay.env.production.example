# NegosyoWork Studio: relay/.env on the server. Copy this to relay/.env there.

# Same value as RELAY_SECRET in backend/.env.
RELAY_SECRET=CHANGE_ME

# The API site (the relay checks each stream with Laravel there).
LARAVEL_URL=https://DOMAIN

# Local only: Nginx passes https://DOMAIN/relay to this port.
RELAY_PORT=8090
RELAY_HOST=127.0.0.1

# FFmpeg installed with `apt install ffmpeg`.
FFMPEG_PATH=/usr/bin/ffmpeg
