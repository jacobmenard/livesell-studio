# Copy to .env.local (never committed) and fill in.

# The Laravel API the app talks to (no trailing slash).
# Android emulator → your computer's Laravel: http://10.0.2.2:8000
# A real phone on the same Wi-Fi: http://<your computer's LAN IP>:8000
# Release APK: https://<your NegosyoWork domain>
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# Set to production for the APK you publish: plain http:// is then refused.
# APP_ENV=production
