APP_NAME="NegosyoWork Studio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

# Where the React app runs (clean-screen links and reset emails point here).
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=livesell
DB_USERNAME=r
DB_PASSWORD=

# Cookie sessions for the SPA (Laravel Sanctum).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# null = the cookie belongs to whatever host the app was opened on (localhost or a LAN IP).
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

# Live updates to the clean screen (Laravel Reverb). Generate your own values:
#   php artisan reverb:install   (or fill in random strings)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

FILESYSTEM_DISK=local
MEDIA_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Gets an email for every payment to check; sellers' replies go here. Empty: superadmins only.
LIVESELL_PAYMENTS_EMAIL=

# Superadmin account created by `php artisan db:seed`. Locally, an empty password is
# generated and printed once; in production SUPERADMIN_PASSWORD is required.
SUPERADMIN_NAME="Super Admin"
SUPERADMIN_EMAIL=superadmin@livesell.test
SUPERADMIN_PASSWORD=

# Production uploads on S3-compatible storage (set MEDIA_DISK=s3 and AWS_URL to a
# separate CDN domain).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Shared with relay/.env: lets the streaming relay swap one-time tickets for stream keys.
# Leave empty to turn "Stream straight to Facebook or YouTube" off.
RELAY_SECRET=
