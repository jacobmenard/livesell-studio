# Leave empty when the API is served from the same domain (recommended; the Vite dev
# server proxies /api, /sanctum and /storage to Laravel).
VITE_API_URL=

# Where `npm run dev` forwards API calls.
VITE_DEV_API_PROXY=http://localhost:8000

# Where `npm run dev` forwards the streaming relay (relay/, npm start).
VITE_DEV_RELAY_PROXY=http://localhost:8090

# Laravel Reverb (live updates to the clean screen). Use the same key as REVERB_APP_KEY.
VITE_REVERB_APP_KEY=
# Leave empty to use the host the app was opened on (works for localhost and LAN IPs).
VITE_REVERB_HOST=
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Background removal model. Self-host this file in production; the default loads it from Google.
VITE_SEGMENTER_MODEL_URL=
